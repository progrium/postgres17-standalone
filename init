#!/bin/busybox sh
/bin/busybox --install -s /bin

export LANG=en_US.utf8
export PATH=/usr/local/bin:$PATH
export PG_VERSION=17.11

mount -t proc none /proc
mount -t sysfs none /sys

mkdir -p /dev/pts
mount -t devpts devpts /dev/pts

mkdir -p /var/run/postgresql
mount -t tmpfs tmpfs /var/run/postgresql

ln -s /proc/self/fd /dev/fd

echo nameserver 8.8.8.8 > /etc/resolv.conf

export PGDATA=/var/lib/postgresql/data
export POSTGRES_DB POSTGRES_USER POSTGRES_PASSWORD

# Host folder that holds pgdata.img. cache=none: the guest page cache
# already sits above ext4, so don't cache again underneath the loop device.
mkdir -p /mnt/host
mount -t 9p \
  -o trans=tcp,port=$P9_PORT,version=9p2000.L,msize=262144,cache=none,aname=data \
  $P9_ADDR /mnt/host

IMG=/mnt/host/pgdata.img
DEV=/dev/loop0
SIZE=${PGDATA_SIZE:-10G}

# Size the backing file BEFORE attaching: loop reads the size at attach time.
# Sparse, so a fresh 10G image uses almost no host disk.
[ -s $IMG ] || truncate -s $SIZE $IMG

[ -b $DEV ] || mknod $DEV b 7 0
losetup $DEV $IMG || { echo "init: losetup failed"; exec sh; }

if [ "$(cat /sys/block/loop0/size)" = 0 ]; then
  echo "init: $IMG has size 0 over 9P"; exec sh
fi

# Format only on first boot.
if ! blkid $DEV | grep -q 'TYPE="ext4"'; then
  mkfs.ext4 -q -L pgdata -i 65536 -J size=64 -E nodiscard $DEV
fi

mkdir -p /var/lib/postgresql
mount -t ext4 -o noatime,noinit_itable $DEV /var/lib/postgresql

mkdir -p $PGDATA
chown postgres:postgres /var/lib/postgresql $PGDATA
chmod 700 $PGDATA

setsid -c ${START:-/bin/sh} -i <>/dev/hvc0 >&0 2>&1 &
PG=$!

# Control channel to the host: it sends "stop" to request a clean
# shutdown. INT is a Postgres fast shutdown; HUP covers the debug shell,
# which ignores INT. The fifo carries our reply back on the same socket.
CTL=/run/ctl
mkdir -p /run
mount -t tmpfs tmpfs /run
mkfifo $CTL
exec 3<>$CTL
(nc $P9_ADDR $CTL_PORT <$CTL | while read -r cmd; do
  if [ "$cmd" = stop ]; then
    kill -INT $PG 2>/dev/null
    kill -HUP $PG 2>/dev/null
  fi
done) &

wait $PG
RC=$?

umount /var/lib/postgresql
losetup -d $DEV
sync
echo "halted $RC" >&3
# give the host a moment to read it before the VM disappears
sleep 1
poweroff -f