#!/usr/bin/env bash
# Lima VMs for running and testing postgres17-standalone on linux, alpine
# (linux-musl), macos and windows.
#
#   .dev/vm up <os>             create/start postgres17-<os> and prepare it
#   .dev/vm down <os>           stop it
#   .dev/vm rm <os>             delete it
#   .dev/vm status              list postgres17 VMs
#   .dev/vm shell <os>          ssh into it
#   .dev/vm run <os> [args...]  build, copy and run postgres17-standalone in
#                               the guest's desktop session (POSTGRES_* env is
#                               passed through)
#   .dev/vm test [os...]        run the tests (default: running VMs)
#
# Everything is copied to ~/postgres17 in the guest, which is also the working
# directory, so `.dev/vm run linux data` uses ~/postgres17/data.
set -euo pipefail

DEV="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(dirname "$DEV")"
OSES=(linux alpine macos windows)
BIN=postgres17-standalone

die() { echo "vm: $*" >&2; exit 1; }
log() { echo "vm: $*" >&2; }

inst() { echo "postgres17-$1"; }

check_os() {
	case "${1:-}" in linux|alpine|macos|windows) ;; *) die "unknown os '${1:-}' (want: ${OSES[*]})" ;; esac
}

field() { limactl list "$(inst "$1")" --format "{{.$2}}" 2>/dev/null; }
exists() { [[ -n "$(field "$1" Name)" ]]; }
running() { [[ "$(field "$1" Status)" == Running ]]; }

ssh_() {
	local os=$1; shift
	ssh -F "$(field "$os" Dir)/ssh.config" "lima-$(inst "$os")" "$@"
}

scp_() {
	local os=$1; shift
	scp -q -F "$(field "$os" Dir)/ssh.config" "$@"
}

goarch() {
	case "$(field "$1" Arch)" in x86_64) echo amd64 ;; *) echo arm64 ;; esac
}

# quote args for a POSIX shell in the guest
shquote() {
	local out=() a
	for a in "$@"; do out+=("'${a//\'/\'\\\'\'}'"); done
	echo "${out[*]-}"
}

envpairs() {
	local kv
	while IFS= read -r kv; do
		[[ "$kv" == POSTGRES* ]] && echo "$kv"
	done < <(env)
	return 0
}

cmd_up() {
	check_os "$1"
	local os=$1 name; name=$(inst "$1")
	if ! exists "$os"; then
		if [[ "$os" == windows && -n "${WIN_ISO:-}" ]]; then
			limactl create --tty=false --name "$name" \
				--set ".images[0].location=\"$WIN_ISO\"" "$DEV/lima/$os.yaml"
		else
			limactl create --tty=false --name "$name" "$DEV/lima/$os.yaml"
		fi
	fi
	running "$os" || limactl start --tty=false "$name"
	"setup_$os"
	log "$name ready"
}

setup_linux() { :; }
setup_alpine() { :; }

# macOS: the web view needs a GUI session, so enable auto-login, and allow running
# commands in that session (launchctl asuser) without a password.
# sysadminctl -autologin fails to write /etc/kcpassword in Lima guests
# (SACSetAutoLoginPassword error:22), so it is written here instead.
setup_macos() {
	local os=macos
	if ssh_ $os 'test -f /etc/sudoers.d/postgres17 && test "$(stat -f %Su /dev/console)" = "$USER"'; then
		return
	fi
	log "enabling auto-login and passwordless launchctl"
	ssh_ $os 'cat ~/password' | kcpassword | ssh_ $os 'set -e
		cat > /tmp/kcpassword
		pw=$(cat ~/password)
		echo "$pw" | sudo -S -p "" sh -c "
			install -m 600 -o root -g wheel /tmp/kcpassword /etc/kcpassword
			defaults write /Library/Preferences/com.apple.loginwindow autoLoginUser \"$USER\"
			echo \"$USER ALL=(root) NOPASSWD: /bin/launchctl\" > /etc/sudoers.d/postgres17
			chmod 440 /etc/sudoers.d/postgres17
		"
		rm /tmp/kcpassword'
	log "restarting for auto-login"
	limactl restart --tty=false "$(inst $os)"
	local i
	for i in $(seq 60); do
		ssh_ $os 'test "$(stat -f %Su /dev/console)" = "$USER"' 2>/dev/null && return
		sleep 2
	done
	die "macos: no GUI session after restart; log in via the VM display"
}

# kcpassword encodes the password on stdin in /etc/kcpassword's format: XOR
# with a fixed key, zero padded to a multiple of 12 bytes.
kcpassword() {
	python3 -c '
import sys
pw = sys.stdin.buffer.read().strip()
key = [0x7D, 0x89, 0x52, 0x23, 0xD2, 0xBC, 0xDD, 0xEA, 0xA3, 0xB9, 0x1F]
n = len(pw) + 1
n += (-n) % 12
buf = pw + bytes(n - len(pw))
sys.stdout.buffer.write(bytes(b ^ key[i % len(key)] for i, b in enumerate(buf)))
'
}

# Windows: .dev/winrun (a small Go program, since PowerShell takes ~20s to
# start in the ARM64 guest) enables auto-logon and runs programs in the
# desktop session via a scheduled task.
winrun() {
	local out="$ROOT/.dev/build/windows"
	mkdir -p "$out"
	(cd "$DEV/winrun" && GOWORK=off CGO_ENABLED=0 GOOS=windows GOARCH="$(goarch windows)" go build -trimpath -o "$out/winrun.exe" .)
	ssh_ windows 'mkdir postgres17' </dev/null >/dev/null 2>&1 || true
	# A running exe can't be overwritten but can be renamed, so stage the new
	# one and swap it in, in case a stuck run still holds winrun.exe.
	scp_ windows "$out/winrun.exe" "lima-$(inst windows):postgres17/winrun.new.exe" </dev/null
	# No parentheses: cmd over Lima's sshd rejects grouped commands (exit 255).
	ssh_ windows 'cd postgres17 & del /q winrun.old.exe 2>nul & move /y winrun.exe winrun.old.exe >nul 2>nul & move /y winrun.new.exe winrun.exe >nul' </dev/null \
		|| die "windows: could not install winrun.exe"
}

setup_windows() {
	local os=windows i
	winrun
	for i in $(seq 60); do
		ssh_ $os 'postgres17\winrun.exe setup' </dev/null | grep -q session && return
		sleep 2
	done
	die "windows: no desktop session; log in via the VM display"
}

cmd_down() { check_os "$1"; limactl stop "$(inst "$1")"; }
cmd_rm() { check_os "$1"; limactl delete --force "$(inst "$1")"; }
cmd_status() { limactl list | awk 'NR==1 || $1 ~ /^postgres17-/'; }

cmd_shell() {
	check_os "$1"; running "$1" || die "$(inst "$1") is not running (.dev/vm up $1)"
	ssh_ "$1" -t
}

# build cross-compiles postgres17-standalone and the .dev/pgtest helper and
# copies them into ~/postgres17 in the guest.
build() {
	local os=$1 goos=$1 exe=
	running "$os" || die "$(inst "$os") is not running (.dev/vm up $os)"
	case "$os" in
		macos) goos=darwin ;;
		alpine) goos=linux-musl ;;
		windows) exe=.exe ;;
	esac
	local out="$ROOT/.dev/build/$os" arch; arch=$(goarch "$os")
	mkdir -p "$out"
	make -s -C "$ROOT" build OS=$goos GOARCH="$arch" VERSION= GOARGS="-o $out/$BIN$exe"
	(cd "$DEV/pgtest" && GOWORK=off CGO_ENABLED=0 GOOS="${goos%-musl}" GOARCH="$arch" go build -trimpath -o "$out/pgtest$exe" .)
	ssh_ "$os" 'mkdir postgres17' </dev/null >/dev/null 2>&1 || true
	scp_ "$os" "$out/$BIN$exe" "$out/pgtest$exe" "lima-$(inst "$os"):postgres17/" </dev/null
	[[ "$os" != windows ]] || winrun
}

# run_<os> <prog> [args...] runs a program from ~/postgres17 in the guest's
# desktop session with stdio attached.
envs() { envpairs | while IFS= read -r kv; do shquote "$kv"; done | tr '\n' ' '; }
tty_() { [[ -t 0 && -t 1 ]] && echo -t || true; }

run_linux() {
	local prog=$1; shift
	ssh_ linux $(tty_) "cd postgres17 && env $(envs) ./$prog $(shquote "$@")"
}

run_alpine() {
	local prog=$1; shift
	ssh_ alpine $(tty_) "cd postgres17 && env $(envs) ./$prog $(shquote "$@")"
}

run_macos() {
	local prog=$1; shift
	ssh_ macos $(tty_) "cd postgres17 && sudo -n launchctl asuser \$(id -u) sudo -n -u \$USER env $(envs) ./$prog $(shquote "$@")"
}

# Windows has no way to attach ssh stdio to a process in the desktop session,
# so stdin is staged to a file and output is collected after the task ends.
run_windows() {
	local prog=$1.exe; shift
	local stdin=/dev/null
	[[ -t 0 ]] || stdin=-
	local tmp code=0; tmp=$(mktemp -d)
	cat "$stdin" > "$tmp/stdin.txt"
	envpairs > "$tmp/env.txt"
	scp_ windows "$tmp/stdin.txt" "$tmp/env.txt" "lima-$(inst windows):postgres17/" </dev/null
	rm -rf "$tmp"
	ssh_ windows "${VM_TIMEOUT:+set VM_TIMEOUT=$VM_TIMEOUT&& }postgres17\\winrun.exe run $(winquote "$prog" "$@")" </dev/null || code=$?
	return $code
}

# quote args for a Windows command line (CommandLineToArgvW rules)
winquote() {
	local out=() a
	for a in "$@"; do
		if [[ -n "$a" && "$a" != *[[:space:]\"]* ]]; then
			out+=("$a")
		else
			a=$(printf '%s' "$a" | sed -E 's/(\\*)"/\1\1\\"/g; s/(\\+)$/\1\1/')
			out+=("\"$a\"")
		fi
	done
	echo "${out[*]-}"
}

cmd_run() {
	check_os "${1:-}"; local os=$1; shift
	build "$os"
	"run_$os" "$BIN" "$@"
}

cmd_test() {
	local oses=("$@") os fail=0
	if [[ ${#oses[@]} -eq 0 ]]; then
		for os in "${OSES[@]}"; do running "$os" && oses+=("$os"); done
		[[ ${#oses[@]} -gt 0 ]] || die "no postgres17 VMs running (.dev/vm up <os>)"
	fi
	for os in "${oses[@]}"; do
		check_os "$os"
		echo "== $os"
		build "$os"
		VM_OS=$os VM="$0" bash "$DEV/test.sh" || fail=1
	done
	return $fail
}

[[ $# -gt 0 ]] || { sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
cmd=$1; shift
case "$cmd" in
	up|down|rm|shell) [[ $# -eq 1 ]] || die "usage: .dev/vm $cmd <os>"; "cmd_$cmd" "$1" ;;
	status|test) "cmd_$cmd" "$@" ;;
	run) cmd_run "$@" ;;
	_run) check_os "${1:-}"; os=$1; shift; "run_$os" "$@" ;; # run <prog> without rebuilding (used by test.sh)
	*) die "unknown command '$cmd'" ;;
esac
